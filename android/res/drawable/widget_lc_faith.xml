<?xml version="1.0" encoding="utf-8"?>
<!-- Cards widget card, faith colour: dark glass with a glowing edge (like the Lists carousel cards) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="4.0dip" android:color="#22F0C862" />
            <corners android:radius="28.0dip" />
        </shape>
    </item>
    <item android:left="2.0dip" android:top="2.0dip" android:right="2.0dip" android:bottom="2.0dip">
        <shape android:shape="rectangle">
            <gradient android:startColor="#fa262a3e" android:centerColor="#fa141a2c" android:endColor="#fa10162a" android:angle="315.0" />
            <stroke android:width="1.5dip" android:color="#ffF0C862" />
            <corners android:radius="26.0dip" />
        </shape>
    </item>
</layer-list>
