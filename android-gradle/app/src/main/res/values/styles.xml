<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Plotlines" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">#0A0A12</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Plotlines.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0A0A12</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_round</item>
        <item name="postSplashScreenTheme">@style/Theme.Plotlines</item>
    </style>
</resources>
